---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const effectiveDate = 'October 11, 2026';
const contactEmail = 'adrianmolina39@gmail.com';
const developerName = "Drake's Workshop";
const appName = 'Our Chats';

interface Section {
  id: string;
  title: string;
  paragraphs?: string[];
  items?: string[];
}

const sections: Section[] = [
  {
    id: 'access',
    title: 'What the app accesses',
    paragraphs: [
      `${appName} only reads the chat export file (.zip or .txt) that you choose to open. It does not access your contacts, your WhatsApp account or any other files.`,
    ],
  },
  {
    id: 'on-device',
    title: 'What happens on your device',
    items: [
      'Statistics (message counts, streaks, emoji, response times, etc.) are calculated on your device',
      'Your chats are not stored on any server or database of ours',
      'No account or sign-up is required',
    ],
  },
  {
    id: 'external',
    title: 'Features that use an external service',
    paragraphs: [
      'Some result cards (such as conversation topics, inside jokes, the summary and the humor evolution) are generated by an external artificial intelligence service. To create them, the app sends a sample of up to about 200 messages, each shortened to 200 characters, together with the participants’ names, over an encrypted connection (HTTPS).',
      'This service is provided by Google (Gemini API), which processes the data under its own terms. Under the terms of the service currently used, Google may use the submitted content to improve its products, and it may be reviewed by people. We do not store these requests or have access to them afterwards.',
      'If the chat contains Spotify links, the app asks Spotify for the song title of the most shared link.',
    ],
  },
  {
    id: 'not-collected',
    title: 'What the app does not do',
    items: [
      'It does not show ads or use analytics or tracking services',
      'It does not sell your data',
      'It does not keep a copy of your chats',
    ],
  },
  {
    id: 'others',
    title: 'Messages from other people',
    paragraphs: [
      'A chat export includes messages written by other people. Only analyze chats that you have the right to share and, where appropriate, with the consent of the other participants.',
    ],
  },
  {
    id: 'age',
    title: 'Age requirement',
    paragraphs: ['The app is intended for people aged 18 and over.'],
  },
  {
    id: 'changes',
    title: 'Changes to this policy',
    paragraphs: [
      'If this policy changes, the updated version will be published at this same address with a new effective date.',
    ],
  },
];

const sectionsEs: Section[] = [
  {
    id: 'es-access',
    title: 'A qué accede la app',
    paragraphs: [
      `${appName} solo lee el archivo de exportación de chat (.zip o .txt) que tú eliges abrir. No accede a tus contactos, a tu cuenta de WhatsApp ni a otros archivos.`,
    ],
  },
  {
    id: 'es-on-device',
    title: 'Qué ocurre en tu dispositivo',
    items: [
      'Las estadísticas (número de mensajes, rachas, emojis, tiempos de respuesta, etc.) se calculan en tu dispositivo',
      'Tus chats no se guardan en ningún servidor ni base de datos nuestra',
      'No necesitas crear una cuenta',
    ],
  },
  {
    id: 'es-external',
    title: 'Funciones que usan un servicio externo',
    paragraphs: [
      'Algunas tarjetas de resultados (como los temas de conversación, las bromas internas, el resumen y la evolución del humor) se generan con un servicio externo de inteligencia artificial. Para crearlas, la app envía una muestra de hasta unos 200 mensajes, cada uno recortado a 200 caracteres, junto con los nombres de los participantes, mediante una conexión cifrada (HTTPS).',
      'Este servicio lo presta Google (API de Gemini), que trata los datos según sus propios términos. Según los términos del servicio que se usa actualmente, Google puede usar el contenido enviado para mejorar sus productos y puede ser revisado por personas. Nosotros no guardamos estas solicitudes ni tenemos acceso a ellas después.',
      'Si el chat contiene enlaces de Spotify, la app consulta a Spotify el título de la canción más compartida.',
    ],
  },
  {
    id: 'es-not-collected',
    title: 'Qué no hace la app',
    items: [
      'No muestra anuncios ni usa servicios de analítica o rastreo',
      'No vende tus datos',
      'No guarda una copia de tus chats',
    ],
  },
  {
    id: 'es-others',
    title: 'Mensajes de otras personas',
    paragraphs: [
      'Una exportación de chat incluye mensajes escritos por otras personas. Analiza solo chats que tengas derecho a compartir y, cuando corresponda, con el consentimiento de los demás participantes.',
    ],
  },
  {
    id: 'es-age',
    title: 'Edad mínima',
    paragraphs: ['La app está dirigida a personas mayores de 18 años.'],
  },
  {
    id: 'es-changes',
    title: 'Cambios en esta política',
    paragraphs: [
      'Si esta política cambia, la nueva versión se publicará en esta misma dirección con una fecha nueva.',
    ],
  },
];
---

<BaseLayout
  title={`Privacy Policy — ${appName}`}
  description={`Privacy Policy for ${appName} by ${developerName}. Your chats are never stored on our servers.`}
>
  <Navbar />

  <main class="pt-24 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <div class="mb-12">
          <a
            href="/privacy"
            class="flex w-fit items-center gap-2 text-sm text-zinc-500 hover:text-zinc-300 transition-colors mb-8"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
            </svg>
            All privacy policies
          </a>

          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-400 text-xs font-medium mb-5"
          >
            Legal Document · {appName}
          </div>

          <h1 class="text-4xl sm:text-5xl font-black text-white mb-4 tracking-tight">
            Privacy Policy
          </h1>
          <p class="text-zinc-400 text-lg">
            <strong class="text-zinc-200">{appName}</strong> is developed by
            <strong class="text-zinc-200">{developerName}</strong>. In short: statistics are calculated on
            your device and your chats are never stored on our servers.
          </p>
          <p class="text-zinc-500 text-sm mt-4">
            <strong class="text-zinc-400">Effective Date:</strong>
            {effectiveDate}
            <span class="mx-2">·</span>
            <a href="#es" class="text-blue-400 hover:text-blue-300 transition-colors">Leer en español</a>
          </p>
        </div>

        <div class="h-px bg-gradient-to-r from-transparent via-zinc-700 to-transparent mb-12" aria-hidden="true"></div>

        <!-- English -->
        <div class="space-y-10 text-zinc-400 leading-relaxed">
          {
            sections.map((section, i) => (
              <section aria-labelledby={`section-${section.id}`}>
                <h2 id={`section-${section.id}`} class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                  <span class="text-blue-400 font-mono text-base">{String(i + 1).padStart(2, '0')}.</span>
                  {section.title}
                </h2>
                {section.paragraphs?.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
                {section.items && (
                  <ul class="mt-3 space-y-2 list-none pl-0">
                    {section.items.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>

        <!-- Spanish -->
        <div class="h-px bg-gradient-to-r from-transparent via-zinc-700 to-transparent my-14" aria-hidden="true"></div>

        <div id="es" class="mb-10">
          <h2 class="text-3xl font-black text-white tracking-tight">Política de privacidad</h2>
          <p class="text-zinc-400 mt-3">
            En resumen: las estadísticas se calculan en tu dispositivo y tus chats nunca se guardan en nuestros servidores.
          </p>
          <p class="text-zinc-500 text-sm mt-3">
            <strong class="text-zinc-400">Fecha de vigencia:</strong> 11 de octubre de 2026
          </p>
        </div>

        <div class="space-y-10 text-zinc-400 leading-relaxed">
          {
            sectionsEs.map((section, i) => (
              <section aria-labelledby={`section-${section.id}`}>
                <h3 id={`section-${section.id}`} class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                  <span class="text-blue-400 font-mono text-base">{String(i + 1).padStart(2, '0')}.</span>
                  {section.title}
                </h3>
                {section.paragraphs?.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
                {section.items && (
                  <ul class="mt-3 space-y-2 list-none pl-0">
                    {section.items.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>

        <!-- Contact -->
        <div class="mt-14 rounded-xl bg-zinc-900 border border-zinc-800 p-5 flex items-start gap-4">
          <div
            class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center flex-shrink-0"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-blue-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-zinc-200 font-semibold text-sm">Contact · Contacto</p>
            <a
              href={`mailto:${contactEmail}`}
              class="text-blue-400 hover:text-blue-300 text-sm transition-colors mt-0.5 block"
            >
              {contactEmail}
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
